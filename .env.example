# ==============================================================================
# Environment Configuration Template (Example)
# Copy this file to .env and replace the values as needed:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# FastAPI Application Settings
API_PORT=8000
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/appdb

# Locust Settings
LOCUST_PORT=8089

# pgAdmin 4 Web UI Settings
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=your_admin_password_here
PGADMIN_PORT=5050

# Redis Cache Settings
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Redis Commander Web UI Settings
REDIS_COMMANDER_PORT=8081

# Prometheus & Grafana Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Mailpit Local Email Testing
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# LocalStack Mock AWS & S3 Browser UI
LOCALSTACK_PORT=4566
S3_BROWSER_PORT=8085
S3_BROWSER_USER=admin
S3_BROWSER_PASS=admin

# Nginx Reverse Proxy Gateway
GATEWAY_PORT=80

