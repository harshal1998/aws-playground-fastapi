# Direct runtime dependencies of the API image. requirements.txt is the lock
# generated from this file (it pins every transitive dependency too) and is
# what the Dockerfile installs. After editing this file, regenerate the lock
# (Git Bash / Linux / macOS):
#   docker run --rm -v "$PWD:/src" -w /src python:3.11-slim sh -c \
#     "pip install -q uv && uv pip compile --universal --python-version 3.11 \
#      requirements.in -o requirements.txt"
